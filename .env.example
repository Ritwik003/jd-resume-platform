# Copy to .env and fill in. .env is gitignored and must stay that way — it
# holds the API key.
#
#   cp .env.example .env

# ---------------------------------------------------------------- application
APP_NAME=JD Resume Platform
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# ------------------------------------------------------------------- database
# Leave blank to use a local SQLite file at data/jd_resume_local.db.
# For PostgreSQL (docker compose up -d db):
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jdresume
DATABASE_URL=
SQL_ECHO=false

# Only read by docker-compose.yml's api/worker/beat containers. If you already
# have Postgres installed on this machine (outside Docker) with real data in
# it, point this at THAT same database via host.docker.internal instead of
# letting compose spin up its own separate, empty one -- same credentials and
# db name as DATABASE_URL above, host swapped:
#   DOCKER_DATABASE_URL=postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/jdresume
# Leave unset to use the throwaway containerized Postgres instead, brought up
# with: docker compose --profile local-db up --build
DOCKER_DATABASE_URL=

# ----------------------------------------------------------------------- auth
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------ LLM
# LLM_OFFLINE_MODE=true runs the whole workflow with no API key, against a
# deterministic stub. That is what the test suite uses.
LLM_OFFLINE_MODE=false
LLM_PROVIDER=openai
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.2

# Sized for a REASONING model, which spends most of its budget thinking before
# it writes a character. A ceiling sized for the answer alone truncates the
# answer — or returns an empty one. This is a ceiling, not a spend: short
# replies still bill short.
LLM_MAX_TOKENS=32000
# Raising the ceiling without raising this only turns truncation into timeouts.
LLM_TIMEOUT_SECONDS=600

# Only the one matching LLM_PROVIDER is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set when pointing LLM_PROVIDER=openai at an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
GROQ_API_KEY=

# ---------------------------------------------------------------- reservation
RESERVATION_DURATION_MINUTES=120
RESERVATION_SWEEP_INTERVAL_SECONDS=60
RESERVATION_SWEEPER_ENABLED=true

# How long an APPROVED resume holds a profile for that vendor while they
# answer. When it runs out the profile shows EXPIRED and is offerable again.
SUBMISSION_HOLD_MINUTES=10080

# --------------------------------------------------------------- file storage
FILE_STORAGE_ROOT=storage
VALIDATION_ENABLED=true

# ------------------------------------------------------------- the resume shape
# Ceilings — the generation form sets the actual counts per resume.
RESUME_MAX_PAGES=2
RESUME_MIN_PROJECTS=4
RESUME_MAX_PROJECTS=8
RESUME_MAX_COMPANIES=6
RESUME_MAX_BULLETS_PER_PROJECT=5

# ---------------------------------------------------------------------- celery
# Optional. Without Redis the work runs in-process, which is fine for one box.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
