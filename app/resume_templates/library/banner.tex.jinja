%% Banner Header — full-width colour band over a compact body.
\documentclass[10pt,a4paper]{article}
%% Helvetica, as an OpenType face so ligatures and kerning can be turned
%% off. Both are invisible on the page and both cost keywords in the
%% text layer an ATS reads: ff becomes one glyph, and a wide kern reads
%% as a space. Loaded by filename because tectonic cannot find these by
%% family name.
\usepackage{fontspec}
\setmainfont{texgyreheros-regular.otf}[
  BoldFont=texgyreheros-bold.otf,
  ItalicFont=texgyreheros-italic.otf,
  BoldItalicFont=texgyreheros-bolditalic.otf,
  Ligatures=NoCommon,
  Kerning=Off]
\usepackage[top=0cm,bottom=1.4cm,left=1.5cm,right=1.5cm]{geometry}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{changepage}

%% The band is tinted and the name on it is dark. It used to be white text
%% on a near-black block, which reads well and is exactly the shape an ATS
%% hidden-text check flags.
\definecolor{bannerbg}{HTML}{EDEFF4}
\definecolor{banner}{HTML}{2B2D42}
\definecolor{accent}{HTML}{2B2D42}
\definecolor{muted}{HTML}{4A4A4A}
\setlist[itemize]{leftmargin=1em,topsep=2pt,itemsep=1pt,parsep=0pt}
\titleformat{\section}{\bfseries\large\color{banner}}{}{0em}{\hspace{-0.2em}}[\vspace{-0.7em}{\color{accent}\rule{2.2cm}{2pt}}]
\titlespacing*{\section}{0pt}{12pt}{7pt}
\pagestyle{empty}
\setlength{\parindent}{0pt}

%% Last-resort stretch before TeX gives up and overflows the margin.
%% A long comma-separated technology list in a wide face can leave no break
%% point that justification accepts, and TeX's answer to that is to set the
%% line too wide and print it past the right edge. This lets it loosen the
%% spaces instead. It engages only where the alternative is an overfull
%% line, so nothing that already fits is typeset any differently.
\emergencystretch=3em
\begin{document}

\noindent\begin{adjustwidth}{-1.5cm}{-1.5cm}
\colorbox{bannerbg}{%
  \begin{minipage}[t]{\dimexpr\linewidth-2\fboxsep}
    \vspace{10pt}
    \hspace{1.5cm}\begin{minipage}{\dimexpr\linewidth-3cm}
      \color{banner}
      {\Huge\bfseries << contact.full_name >>}\par
<% if contact.headline %>
      \vspace{3pt}{\large << contact.headline >>}\par
<% endif %>
      \vspace{5pt}{\small << contact.email >><% if contact.phone %> \textbullet\ << contact.phone >><% endif %><% if contact.location %> \textbullet\ << contact.location >><% endif %><% for link in contact.links %> \textbullet\ << link >><% endfor %>}\par
    \end{minipage}
    \vspace{12pt}
  \end{minipage}}
\end{adjustwidth}

\vspace{10pt}

<% for section in sections %>
<% if section.kind == 'summary' and summary %>
\section{<< section.title >>}
<< summary >>\par

<% elif section.kind == 'skills' and skills %>
\section{<< section.title >>}
<% for group in skills %>
\noindent\hangindent=1.6em\hangafter=1 {\bfseries << group.label >>}\ \ {\color{muted}<< group.joined >>}\par\vspace{1pt}
<% endfor %>

<% elif section.kind == 'experience' and experience %>
\section{<< section.title >>}
<% for job in experience %>
\noindent\begin{minipage}[t]{0.72\linewidth}\strut\raggedright\textbf{<< job.company >>}<% if job.location %>, << job.location >><% endif %>\end{minipage}\hfill\begin{minipage}[t]{0.26\linewidth}\strut\raggedleft << job.dates >>\end{minipage}\par
<% if job.designation %>
\noindent\textit{<< job.designation >>}\par
<% endif %>
<% if job.description %>
\noindent << job.description >>\par
<% endif %>
<% if job.highlights %>
\begin{itemize}
<% for line in job.highlights %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if not projects_section_visible %>
<% for project in job.projects %>
\noindent{\raggedright\textbf{<< project.name >>}\par}
<% if project.description %>
\noindent << project.description >>\par
<% endif %>
<% if project.bullets %>
\begin{itemize}
<% for line in project.bullets %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if project.tech_joined %>
\noindent\textit{<< project.tech_joined >>}\par
<% endif %>
\vspace{3pt}
<% endfor %>
<% endif %>
\vspace{5pt}
<% endfor %>
<% elif section.kind == 'projects' and project_groups %>
\section{<< section.title >>}
<% for group in project_groups %>
<% if group.company %>
\noindent\begin{minipage}[t]{0.72\linewidth}\strut\raggedright\textbf{<< group.company >>}\end{minipage}<% if group.dates %>\hfill\begin{minipage}[t]{0.26\linewidth}\strut\raggedleft << group.dates >>\end{minipage}<% endif %>\par
\vspace{2pt}
<% endif %>
<% for project in group.projects %>
\noindent{\raggedright\textbf{<< project.name >>}\par}
<% if project.description %>
\noindent << project.description >>\par
<% endif %>
<% if project.bullets %>
\begin{itemize}
<% for line in project.bullets %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if project.tech_joined %>
\noindent\textit{<< project.tech_joined >>}\par
<% endif %>
\vspace{3pt}
<% endfor %>
\vspace{4pt}
<% endfor %>
<% elif section.kind == 'education' and education %>
\section{<< section.title >>}
<% for row in education %>
{\bfseries << row.qualification >>}\hfill{\small\color{muted}<< row.year >>}\par
<% if row.institution %>
{\color{muted}<< row.institution >>}\par
<% endif %>
\vspace{2pt}
<% endfor %>

<% elif section.kind == 'certifications' and certifications %>
\section{<< section.title >>}
\begin{itemize}
<% for item in certifications %>
  \item << item >>
<% endfor %>
\end{itemize}

<% elif section.kind == 'custom' %>
<% for block in custom_sections %>
<% if block.title == section.title %>
\section{<< section.title >>}
<% if block.body %>
<< block.body >>\par
<% endif %>
<% if block.items %>
\begin{itemize}
<% for line in block.items %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% endif %>
<% endfor %>

<% endif %>
<% endfor %>
\end{document}
