%% Sidebar Two-Column — tinted left rail, main column for the narrative.
\documentclass[10pt,a4paper]{article}
%% Helvetica, as an OpenType face so ligatures and kerning can be turned
%% off. Both are invisible on the page and both cost keywords in the
%% text layer an ATS reads: ff becomes one glyph, and a wide kern reads
%% as a space. Loaded by filename because tectonic cannot find these by
%% family name.
\usepackage{fontspec}
\setmainfont{texgyreheros-regular.otf}[
  BoldFont=texgyreheros-bold.otf,
  ItalicFont=texgyreheros-italic.otf,
  BoldItalicFont=texgyreheros-bolditalic.otf,
  Ligatures=NoCommon,
  Kerning=Off]
\usepackage[margin=0cm]{geometry}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{paracol}
\usepackage{ragged2e}
\usepackage{eso-pic}

%% A LIGHT rail with dark text on it, not the reverse. Light-coloured text
%% is what keyword-stuffing looks like, and several ATS discard it on sight —
%% so a design that prints the whole left column in near-white is one bad
%% heuristic away from losing a third of the resume. The rail keeps its
%% identity as a tinted column; only the contrast is turned the right way up.
\definecolor{rail}{HTML}{EDF1F6}
\definecolor{railtext}{HTML}{16283D}
\definecolor{accent}{HTML}{1B3A5C}
\setlist[itemize]{leftmargin=1em,topsep=2pt,itemsep=1pt,parsep=0pt}
\pagestyle{empty}
\setlength{\parindent}{0pt}

\newcommand{\railhead}[1]{\vspace{9pt}{\bfseries\normalsize\MakeUppercase{#1}}\par
  \vspace{2pt}\textcolor{railtext}{\rule{\linewidth}{0.6pt}}\par\vspace{4pt}}
\newcommand{\mainhead}[1]{\vspace{10pt}{\color{accent}\bfseries\large\MakeUppercase{#1}}\par
  \vspace{1pt}{\color{accent}\rule{\linewidth}{1.2pt}}\par\vspace{5pt}}

\columnratio{0.32}

%% The rail, painted behind the page on every page it runs onto.
\AddToShipoutPictureBG{\AtPageLowerLeft{\color{rail}\rule{0.32\paperwidth}{\paperheight}}}

%% Last-resort stretch before TeX gives up and overflows the margin.
%% A long comma-separated technology list in a wide face can leave no break
%% point that justification accepts, and TeX's answer to that is to set the
%% line too wide and print it past the right edge. This lets it loosen the
%% spaces instead. It engages only where the alternative is an overfull
%% line, so nothing that already fits is typeset any differently.
\emergencystretch=3em
\begin{document}
\begin{paracol}{2}

\color{railtext}
\vspace*{1.2cm}
\hspace{0.7cm}\begin{minipage}{0.8\linewidth}
\RaggedRight
{\LARGE\bfseries << contact.full_name >>}\par
<% if contact.headline %>
\vspace{3pt}{\small << contact.headline >>}\par
<% endif %>

\railhead{Contact}
{\small
<% if contact.email %>
<< contact.email >>\par\vspace{2pt}
<% endif %>
<% if contact.phone %>
<< contact.phone >>\par\vspace{2pt}
<% endif %>
<% if contact.location %>
<< contact.location >>\par\vspace{2pt}
<% endif %>
<% for link in contact.links %>
<< link >>\par\vspace{2pt}
<% endfor %>
}

<% for section in sections %>
<% if section.kind == 'skills' and skills %>
\railhead{<< section.title >>}
{\small
<% for group in skills %>
\noindent\hangindent=1.6em\hangafter=1 \textbf{<< group.label >>}\par << group.joined >>\par\vspace{4pt}
<% endfor %>
}
<% elif section.kind == 'education' and education %>
\railhead{<< section.title >>}
{\small
<% for row in education %>
\textbf{<< row.qualification >>}\par << row.institution >><% if row.year %>, << row.year >><% endif %>\par\vspace{4pt}
<% endfor %>
}
<% elif section.kind == 'certifications' and certifications %>
\railhead{<< section.title >>}
{\small
<% for item in certifications %>
<< item >>\par\vspace{3pt}
<% endfor %>
}
<% endif %>
<% endfor %>
\end{minipage}

\switchcolumn
\color{black}
\vspace*{1.2cm}
\begin{minipage}{0.88\linewidth}
\RaggedRight

<% for section in sections %>
<% if section.kind == 'summary' and summary %>
\mainhead{<< section.title >>}
<< summary >>\par

<% elif section.kind == 'experience' and experience %>
\section{<< section.title >>}
<% for job in experience %>
\noindent\begin{minipage}[t]{0.72\linewidth}\strut\raggedright\textbf{<< job.company >>}<% if job.location %>, << job.location >><% endif %>\end{minipage}\hfill\begin{minipage}[t]{0.26\linewidth}\strut\raggedleft << job.dates >>\end{minipage}\par
<% if job.designation %>
\noindent\textit{<< job.designation >>}\par
<% endif %>
<% if job.description %>
\noindent << job.description >>\par
<% endif %>
<% if job.highlights %>
\begin{itemize}
<% for line in job.highlights %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if not projects_section_visible %>
<% for project in job.projects %>
\noindent{\raggedright\textbf{<< project.name >>}\par}
<% if project.description %>
\noindent << project.description >>\par
<% endif %>
<% if project.bullets %>
\begin{itemize}
<% for line in project.bullets %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if project.tech_joined %>
\noindent\textit{<< project.tech_joined >>}\par
<% endif %>
\vspace{3pt}
<% endfor %>
<% endif %>
\vspace{5pt}
<% endfor %>
<% elif section.kind == 'projects' and project_groups %>
\section{<< section.title >>}
<% for group in project_groups %>
<% if group.company %>
\noindent\begin{minipage}[t]{0.72\linewidth}\strut\raggedright\textbf{<< group.company >>}\end{minipage}<% if group.dates %>\hfill\begin{minipage}[t]{0.26\linewidth}\strut\raggedleft << group.dates >>\end{minipage}<% endif %>\par
\vspace{2pt}
<% endif %>
<% for project in group.projects %>
\noindent{\raggedright\textbf{<< project.name >>}\par}
<% if project.description %>
\noindent << project.description >>\par
<% endif %>
<% if project.bullets %>
\begin{itemize}
<% for line in project.bullets %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% if project.tech_joined %>
\noindent\textit{<< project.tech_joined >>}\par
<% endif %>
\vspace{3pt}
<% endfor %>
\vspace{4pt}
<% endfor %>
<% elif section.kind == 'custom' %>
<% for block in custom_sections %>
<% if block.title == section.title %>
\mainhead{<< section.title >>}
<% if block.body %>
<< block.body >>\par
<% endif %>
<% if block.items %>
\begin{itemize}
<% for line in block.items %>
  \item << line >>
<% endfor %>
\end{itemize}
<% endif %>
<% endif %>
<% endfor %>

<% endif %>
<% endfor %>
\end{minipage}

\end{paracol}
\end{document}
